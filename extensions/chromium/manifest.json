{
  "manifest_version": 3,
  "name": "Velora Download Manager",
  "short_name": "Velora",
  "version": "0.1.2",
  "description": "Send links, files and media to Velora Download Manager.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab", "scripting", "storage"],
  "optional_permissions": ["downloads"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Velora",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
