{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velora Download Manager",
  "mainBinaryName": "velora",
  "version": "0.1.0-alpha.2",
  "identifier": "com.velora.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Velora",
        "width": 1240,
        "height": 780,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0B1020"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Velora contributors",
    "copyright": "Copyright © 2026 Velora contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Velora Download Manager",
    "longDescription": "A fast, beautiful, open-source download manager with segmented downloads, reliable resume, queues and scheduling.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../extensions/chromium/": "extensions/chromium/",
      "../extensions/firefox/": "extensions/firefox/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false
      }
    }
  }
}
